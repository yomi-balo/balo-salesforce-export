# Required: Bubble.io Data API token
BALO_API_TOKEN=your_bubble_api_token_here

# Optional: Pre-specify record IDs to export (comma-separated)
# If omitted, the tool fetches a sample automatically
BALO_COMPANY_IDS=
BALO_AGENCY_IDS=

# Required when running sync.py (Bubble -> middleware sync).
# Not needed for the XLSX-only export.py path.
MIDDLEWARE_URL=https://sf-middleware-api-production.up.railway.app
MIDDLEWARE_API_SECRET=
# Minimum seconds between POSTs to the middleware. Default 0.1.
MIDDLEWARE_MIN_INTERVAL=0.1
